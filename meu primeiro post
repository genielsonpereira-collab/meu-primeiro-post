header{
    background-color: #0c4480;
    color: #F2F5F9;
    text-align: center;
    margin: 0 auto;
    padding: 16px;
}

main {
    background-color: #F2F5F9;
    color: #0c4480;
    margin: 0 auto;
    padding: 16px;

    display: flex;
    flex-wrap: wrap;
}
article{
    display: flex;

    border:1px solid #050e18;

    margin: 16px;
    gap: 16px;
    padding: 16px;

    flex: 1 1 25%;

    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
}

img{
    width: 80px;
    height: 80px;
}

.artigo-autor {
    font-weight: bold;  
}
